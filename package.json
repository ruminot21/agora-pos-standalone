{
  "name": "agora-pos-universal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Ágora POS - Interfaz táctil React, offline-first y catálogo local",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
