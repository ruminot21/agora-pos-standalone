{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ágora POS",
  "version": "1.0.0",
  "identifier": "com.agorapos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Ágora POS","width":1300,"height":850,"minWidth":890,"minHeight":590}],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico","icons/icon.icns"]
  }
}
